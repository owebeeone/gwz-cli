load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

exports_files(["Cargo.toml"])  # the manifest @crates mirrors by hand (see MODULE.bazel)

# gwz — the GWZ CLI library, atop gwz-core + clap/console/serde_json.
#
# gwz-cli belongs to the OUTER Cargo workspace (//:Cargo.toml). Its three crates.io deps come
# from @crates, a from_specs hub whose crate.spec pins mirror this crate's Cargo.toml
# [dependencies] at the versions in //:Cargo.lock (MODULE.bazel says why the outer workspace
# cannot be spliced with from_cargo). A [dependencies] change in Cargo.toml therefore has to be
# mirrored in MODULE.bazel and here; `gwz-core/scripts/checks/check_bazel_pin_drift.py`, run from
# the gwz-dev root, refuses a version, feature or dependency-set mismatch between the three and a
# `@crates//:` label here that no spec pins. gwz-core is the outer workspace's excluded path dependency
# and is wired to the workspace target //gwz-core:gwz_core, built by the @gwz_core_crates hub
# from gwz-core's own lock -- never a copy of gwz-core spliced into this hub.
#
# Two hubs mean two serde instances in the gwz binary. That is harmless here: gwz-cli hands
# gwz_core values to serde_json only as String / Option / Vec<String> / bool / integer fields
# (see *_json.rs), never as a gwz_core type implementing @gwz_core_crates' serde::Serialize.
rust_library(
    name = "gwz_lib",
    version = "1.0.0-rc.2",
    rustc_env_files = ["build.env"],
    stamp = 1,
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "gwz",
    crate_root = "src/lib.rs",
    edition = "2024",
    compile_data = glob(
        ["src/**"],
        exclude = ["src/**/*.rs"],
        allow_empty = True,
    ),
    deps = [
        "//gwz-core:gwz_core",
        "@crates//:clap",
        "@crates//:console",
        "@crates//:serde_json",
    ],
)

# gwz — the GWZ CLI binary wrapper.
rust_binary(
    name = "gwz",
    version = "1.0.0-rc.2",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [":gwz_lib"],
    visibility = ["//visibility:public"],
)
